        unsupported_higher_order_u32(plus_one_for_higher_order, 41),
        42
    );
    assert_eq!(
        unsupported_higher_order_u32(plus_one_for_higher_order, u32::MAX),
        0
    );
}

#[test]
fn expected_type_propagates_through_nested_constructors() {
