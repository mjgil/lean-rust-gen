    assert_eq!(point_x(Point { x: 8, y: 9 }), 8);
    assert_eq!(point_y(Point { x: 8, y: 9 }), 9);
    assert_eq!(
        shift_point_x(Point { x: u32::MAX, y: 7 }, 1),
        Point { x: 0, y: 7 }
    );
