    assert_eq!(step_amount_or(Step::Jump(12), 99), 12);
    assert_eq!(step_amount_plus_one_or(Step::Stay, 7), 7);
    assert_eq!(step_amount_plus_one_or(Step::Jump(u32::MAX), 7), 0);
}

