    assert_eq!(inc_u32(41), 42);
    assert_eq!(inc_u32(u32::MAX), 0);
    assert_eq!(inc_twice_u32(40), 42);
    assert_eq!(inc_twice_u32(u32::MAX), 1);
    assert_eq!(helper_inc_fixed(41), 42);
    assert_eq!(helper_chain_u32(40), 42);
}

